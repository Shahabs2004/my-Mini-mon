<Window x:Class="SmartViewCompanion.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="#66000000"
        Topmost="True" Cursor="Cross" WindowStartupLocation="Manual">
    <Canvas x:Name="SelectionCanvas" Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
            KeyDown="Window_KeyDown" Focusable="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#DD111923" CornerRadius="6" Padding="12"
                IsHitTestVisible="False">
            <TextBlock Text="Drag to select a capture region  ·  Esc to cancel"
                       Foreground="White" FontSize="15"/>
        </Border>
        <Rectangle x:Name="SelectionRectangle" Stroke="#4DA3FF"
                   StrokeThickness="2" Fill="#334DA3FF"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
    </Canvas>
</Window>