<Window x:Class="SmartViewCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartView Companion" Height="720" Width="1120"
        MinHeight="620" MinWidth="980" Background="#151B23" Foreground="#E8EDF5"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SMARTVIEW COMPANION" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Virtual auxiliary display · Prototype 0.1" Foreground="#9EACBD" Margin="0,4,0,20"/>
                <GroupBox Header="Capture method" Foreground="#E8EDF5" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <ComboBox x:Name="CaptureMethodBox" SelectedIndex="0" Height="32">
                            <ComboBoxItem Content="Automatic (detect &amp; fallback)"/>
                            <ComboBoxItem Content="Windows Graphics Capture"/>
                            <ComboBoxItem Content="DXGI Desktop Duplication"/>
                            <ComboBoxItem Content="GDI BitBlt"/>
                        </ComboBox>
                        <TextBlock Text="Selects how pixels are read from Windows. This is independent of tracking." TextWrapping="Wrap" Foreground="#AAB6C5" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Tracking mode" Foreground="#E8EDF5" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <ComboBox x:Name="TrackingModeBox" SelectedIndex="0" Height="32">
                            <ComboBoxItem Content="Fixed region"/>
                            <ComboBoxItem Content="Mouse pointer"/>
                            <ComboBoxItem Content="Text caret"/>
                            <ComboBoxItem Content="Automatic (mouse / caret)"/>
                        </ComboBox>
                        <TextBlock Text="Selects which point or region the preview follows." TextWrapping="Wrap" Foreground="#AAB6C5" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Output" Foreground="#E8EDF5" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Resolution"/>
                        <ComboBox x:Name="ResolutionBox" SelectedIndex="1" Height="32" Margin="0,5,0,10">
                            <ComboBoxItem Content="320 × 240"/>
                            <ComboBoxItem Content="480 × 320"/>
                            <ComboBoxItem Content="480 × 800"/>
                            <ComboBoxItem Content="Custom (later)"/>
                        </ComboBox>
                        <TextBlock Text="Target frame rate"/>
                        <ComboBox x:Name="FpsBox" SelectedIndex="1" Height="32" Margin="0,5,0,10">
                            <ComboBoxItem Content="5 FPS"/>
                            <ComboBoxItem Content="10 FPS"/>
                            <ComboBoxItem Content="15 FPS"/>
                            <ComboBoxItem Content="30 FPS"/>
                            <ComboBoxItem Content="60 FPS"/>
                        </ComboBox>
                        <TextBlock Text="Zoom"/>
                        <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Orientation"/>
                        <CheckBox x:Name="PortraitCheckBox" Content="Portrait output" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start preview" Padding="18,9" Background="#3978D4" Foreground="White" BorderThickness="0" Click="StartButton_Click"/>
                    <Button Content="Stop" Padding="18,9" Margin="8,0,0,0" Click="StopButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Status: Ready — capture engines are being integrated." TextWrapping="Wrap" Foreground="#F0C674" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="2" Background="#202733" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Virtual display preview" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="SIMULATOR" Foreground="#75B798" DockPanel.Dock="Right"/>
                </DockPanel>
                <Border Grid.Row="1" Margin="0,18" Background="#080B10" BorderBrush="#526174" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Border Width="480" Height="320" MaxWidth="100%" MaxHeight="100%" Background="#111923" BorderBrush="#3978D4" BorderThickness="2" CornerRadius="5">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="SMARTVIEW" FontSize="24" FontWeight="Bold" Foreground="#DCEBFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Preview surface" Foreground="#91A5BD" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Live capture will appear here" Foreground="#65778D" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2">
                    <TextBlock Text="Capture: not started" Foreground="#AAB6C5"/>
                    <TextBlock Text="FPS: —    Latency: —" Foreground="#AAB6C5" DockPanel.Dock="Right"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
